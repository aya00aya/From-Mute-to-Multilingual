# LiveKit (cloud.livekit.io -> create project -> Settings -> Keys)
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Used from Milestone 3 onward
DEEPGRAM_API_KEY=
GOOGLE_TRANSLATE_KEY=
ELEVENLABS_API_KEY=

# Used when the in-memory store is swapped for Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
